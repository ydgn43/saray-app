# Copy of this file becomes backend\config.env (scripts\1-create-config.ps1 does it for you
# and fills in the values marked AUTO). backend\config.env is never committed to git.

# --- Server ---
PORT_HTTP=3001
NODE_ENV=production

# --- Database (the database lives on this same laptop) ---
HOST_RELATIONAL_DB=127.0.0.1
PORT_RELATIONAL_DB=3306
SCHEMA_RELATIONAL_DB=saray_appdb
USER_RELATIONAL_DB=saray_app
PASSWORD_RELATIONAL_DB=AUTO

# --- Login security ---
# A fresh random secret, different from every other instance (AUTO: 64 random hex characters).
# If you ever change it, everybody is logged out. Never copy it from another instance.
# To make one by hand (PowerShell):
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
JWT_SECRET=AUTO

# --- Public address (AUTO from the -PublicUrl you give the script) ---
# Exactly the address people type in the browser, with https://, no slash at the end.
ALLOWED_ORIGINS=AUTO
FRONTEND_URL=AUTO

# --- Hosting mode: the backend also serves the built web app ---
SERVE_FRONTEND=true
